{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "diagnostics": {
    "disable": [
      "missing-fields",
      "trailing-space",
      "unused-local",
      "unused-function"
    ],
    "globals": ["vim"]
  },
  "workspace": {
    "useGitIgnore": false,
    "checkThirdParty": false
  },
  "completion": {
    "autoRequire": true,
    "callSnippet": "Replace"
  },
  "hint": {
    "enable": true,
    "setType": true,
    "arrayIndex": "Disable"
  },
  "format.enable": false,
  "codeLens.enable": true
}
