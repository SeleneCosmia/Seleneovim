{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "completion": {
    "callSnippet": "Replace",
    "autoRequire": false
  },
  "diagnostics": {
    "disable": [
      "missing-fields",
      "unused-local",
      "unused-function"
    ],
    "globals": ["vim"]
  },
  "format.enable": false,
  "hint.enable": true,
  "workspaceEvent": "OnSave",
  "workspace": {
    "checkThirdParty": false,
    "maxPreload": 10000,
    "preloadFileSize": 1200
  }
}
